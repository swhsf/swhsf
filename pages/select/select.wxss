.container {
  padding: 30rpx;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.section {
  flex: 1;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #333;
}

.list {
  height: 250rpx;
  border: 1rpx solid #eee;
  border-radius: 16rpx;
  padding: 10rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
  font-size: 28rpx;
}

.item.active {
  background: #e6f7ff;
  color: #1890ff;
  font-weight: bold;
}

.check {
  color: #1890ff;
  font-weight: bold;
}

.confirm-btn {
  margin-top: 20rpx;
  border-radius: 16rpx;
}
